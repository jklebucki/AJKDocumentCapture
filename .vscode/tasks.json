{
  "version": "2.0.0",
  "tasks": [
    { "label": "restore", "type": "shell", "command": "dotnet restore InvoiceCapture.slnx" },
    { "label": "build", "type": "shell", "command": "dotnet build InvoiceCapture.slnx -c Release --no-restore" },
    { "label": "test", "type": "shell", "command": "dotnet test InvoiceCapture.slnx -c Release --no-build" },
    { "label": "format-check", "type": "shell", "command": "dotnet format InvoiceCapture.slnx --no-restore --verify-no-changes" },
    { "label": "compose-up", "type": "shell", "command": "./scripts/dev-up.sh" },
    { "label": "compose-down", "type": "shell", "command": "./scripts/dev-down.sh" },
    { "label": "logs", "type": "shell", "command": "cd deploy && docker compose --env-file .env logs -f" },
    { "label": "verify", "type": "shell", "command": "./scripts/verify.sh" }
  ]
}
