          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="InvoiceNumber" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Źródło: Comarch EDI XML INVOICE 7.77, strona 1. Profil: Faktura KSeF. Kardynalność wg tabeli: M. Format wg tabeli: X(256). Numer faktury</xs:documentation>
