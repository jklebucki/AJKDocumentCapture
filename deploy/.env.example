# Copy to deploy/.env. Do not commit actual secrets.
POSTGRES_DB=invoice_capture
POSTGRES_USER=invoice
POSTGRES_PASSWORD=replace-with-a-secret
DB_CONNECTION=Host=postgres;Port=5432;Database=invoice_capture;Username=invoice;Password=replace-with-a-secret
WEB_BIND=127.0.0.1
WEB_PORT=8088
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gpt-oss:20b
