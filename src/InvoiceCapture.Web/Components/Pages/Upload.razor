@page "/documents/upload"
@inject UploadDocumentHandler UploadHandler
@inject NavigationManager Navigation

<PageTitle>Upload document</PageTitle>

<section class="page-shell" aria-labelledby="upload-title">
    <header class="page-heading">
        <div>
            <p class="eyebrow">Operations</p>
            <h1 id="upload-title">Upload document</h1>
            <p class="page-description">PDF, JPEG, PNG or TIFF; maximum 25 MiB.</p>
        </div>
        <a class="button button-secondary" href="/documents">Back to queue</a>
    </header>
    <section class="workspace-card detail-card">
        <InputFile OnChange="UploadAsync" accept="application/pdf,image/jpeg,image/png,image/tiff" aria-label="Select a document" />
        <p aria-live="polite">@message</p>
    </section>
</section>

@code {
    private string message = string.Empty;

    private async Task UploadAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        using var cancellation = new CancellationTokenSource(TimeSpan.FromMinutes(2));
        await using var content = file.OpenReadStream(25L * 1024 * 1024, cancellation.Token);
        try
        {
            var result = await UploadHandler.HandleAsync(new UploadRequest(file.Name, file.ContentType, content, Guid.NewGuid().ToString("N")), cancellation.Token);
            message = "Document accepted. Processing has been queued.";
            Navigation.NavigateTo($"/documents/{result.DocumentId}");
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException)
        {
            message = exception.Message;
        }
    }
}
