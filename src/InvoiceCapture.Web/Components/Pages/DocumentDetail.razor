@page "/documents/{DocumentId:guid}"
@inject IInvoiceRepository InvoiceRepository
@inject IProcessingJobRepository ProcessingJobRepository
@inject LoadExtractionArtifactHandler ExtractionArtifactHandler
@inject LoadOllamaRequestArtifactHandler OllamaRequestArtifactHandler
@inject UpdateManualInvoiceHandler ManualInvoiceHandler
@inject IJSRuntime JS

<PageTitle>Document details</PageTitle>

<section class="page-shell" aria-labelledby="document-title">
    @if (document is null)
    {
        <div class="workspace-card loading-state">Document not found.</div>
    }
    else
    {
        <header class="page-heading">
            <div>
                <p class="eyebrow">Document</p>
                <h1 id="document-title">@document.Source.OriginalFileName</h1>
                <p class="page-description">Review extracted parties and processing outcome.</p>
            </div>
            <a class="button button-secondary" href="/documents">Back to queue</a>
        </header>
        <div class="detail-grid">
            <section class="workspace-card detail-card">
                <h2>Processing</h2>
                <dl class="definition-list">
                    <dt>Status</dt><dd aria-live="polite"><span class="status-pill status-@document.Status.ToString().ToLowerInvariant()">@document.Status</span></dd>
                    <dt>Type</dt><dd>@document.Type</dd>
                    <dt>Source hash</dt><dd><code>@document.Source.Sha256</code></dd>
                </dl>
            </section>
            <section class="workspace-card detail-card">
                <h2>Parties</h2>
                <dl class="definition-list">
                    <dt>Buyer</dt><dd>@Display(document.Buyer?.Name)</dd>
                    <dt>Buyer NIP</dt><dd><code>@Display(document.Buyer?.Nip)</code></dd>
                    <dt>Seller</dt><dd>@Display(document.Seller?.Name)</dd>
                    <dt>Seller NIP</dt><dd><code>@Display(document.Seller?.Nip)</code></dd>
                </dl>
            </section>
        </div>
        <section class="workspace-card detail-card issues-card" aria-labelledby="manual-data-title">
            <div class="detail-card-heading">
                <div>
                    <h2 id="manual-data-title">Manual completion</h2>
                    <p>Correct or complete extracted data, then rerun deterministic validation.</p>
                </div>
            </div>
            @if (manualSuccess is not null)
            {
                <p class="inline-success" role="status">@manualSuccess</p>
            }
            @if (manualError is not null)
            {
                <p class="inline-alert" role="alert">@manualError</p>
            }
            <EditForm Model="@document" OnValidSubmit="SaveManualAsync">
                <div class="manual-form-grid">
                    <label>Invoice number <input @bind="invoiceNumber" /></label>
                    <label>Issue date <InputDate @bind-Value="issueDate" /></label>
                    <label>Due date <InputDate @bind-Value="dueDate" /></label>
                    <label>Currency <input @bind="currency" maxlength="3" /></label>
                    <label>Buyer name <input @bind="buyerName" /></label>
                    <label>Buyer NIP <input @bind="buyerNip" inputmode="numeric" /></label>
                    <label>Seller name <input @bind="sellerName" /></label>
                    <label>Seller NIP <input @bind="sellerNip" inputmode="numeric" /></label>
                    <label>Payment method <input @bind="paymentMethod" /></label>
                    <label>Bank account <input @bind="bankAccount" /></label>
                    <label>Net amount <InputNumber @bind-Value="netAmount" step="0.01" /></label>
                    <label>VAT amount <InputNumber @bind-Value="vatAmount" step="0.01" /></label>
                    <label>Gross amount <InputNumber @bind-Value="grossAmount" step="0.01" /></label>
                </div>
                <div class="manual-form-actions">
                    <button class="button button-primary" type="submit" disabled="@isSaving">@(isSaving ? "Saving…" : "Save and validate")</button>
                </div>
            </EditForm>
        </section>
        @if (document.Issues.Count > 0)
        {
            <section class="workspace-card detail-card issues-card">
                <h2>Validation issues</h2>
                <ul class="issue-list">
                    @foreach (var issue in document.Issues)
                    {
                        <li @key="issue.Code"><strong>@issue.Code</strong> @issue.Message</li>
                    }
                </ul>
            </section>
        }
        <section class="workspace-card detail-card issues-card" aria-labelledby="processing-log-title">
            <h2 id="processing-log-title">Processing log</h2>
            @if (events.Count == 0)
            {
                <p class="diagnostic-detail">No persisted events exist for this document yet. New processing runs record every start, stage, retry and result.</p>
            }
            else
            {
                <ol class="event-log" aria-live="polite">
                    @foreach (var processingEvent in events)
                    {
                        <li @key="@(processingEvent.OccurredAt.ToUnixTimeMilliseconds().ToString() + processingEvent.Kind)">
                            <time datetime="@processingEvent.OccurredAt.ToString("O")">@processingEvent.OccurredAt.LocalDateTime.ToString("dd MMM yyyy, HH:mm:ss")</time>
                            <strong>@processingEvent.Kind</strong>
                            <span class="event-detail">
                                @DescribeEvent(processingEvent)
                                @if (IsOllamaExtraction(processingEvent))
                                {
                                    <button class="icon-button event-json-button" type="button" @onclick="ShowExtractionModal" aria-label="Show Ollama JSON response" aria-haspopup="dialog" data-tooltip="Show Ollama JSON response">
                                        <img src="icons/bootstrap-icons-1.13.1/file-earmark-code.svg" alt="" aria-hidden="true" />
                                    </button>
                                }
                                @if (TryGetOllamaRequestArtifactId(processingEvent, out var requestArtifactId))
                                {
                                    <button class="icon-button event-json-button" type="button" @onclick="() => ShowOllamaRequestModalAsync(requestArtifactId)" aria-label="Show exact Ollama request" aria-haspopup="dialog" data-tooltip="Show exact Ollama request">
                                        <img src="icons/bootstrap-icons-1.13.1/file-earmark-code.svg" alt="" aria-hidden="true" />
                                    </button>
                                }
                            </span>
                        </li>
                    }
                </ol>
            }
        </section>
        @if (isArtifactModalVisible)
        {
            <div class="modal-backdrop" @onclick="CloseArtifactModal">
                <section class="artifact-modal" role="dialog" aria-modal="true" aria-labelledby="artifact-modal-title" @onclick:stopPropagation="true" @onkeydown="HandleArtifactModalKeyDown" tabindex="-1">
                    <header class="artifact-modal-header">
                        <h2 id="artifact-modal-title">@artifactModalTitle</h2>
                        <div class="artifact-modal-actions">
                            <button class="icon-button" type="button" @onclick="CopyArtifactAsync" disabled="@(artifactModalContent is null)" aria-label="Copy displayed content" data-tooltip="Copy content">
                                <img src="icons/bootstrap-icons-1.13.1/clipboard.svg" alt="" aria-hidden="true" />
                            </button>
                            <button class="button button-quiet button-small" type="button" @onclick="CloseArtifactModal">Close</button>
                        </div>
                    </header>
                    <div class="artifact-modal-body">
                        @if (artifactCopyStatus is not null)
                        {
                            <p class="inline-success artifact-copy-status" role="status" aria-live="polite">@artifactCopyStatus</p>
                        }
                        @if (artifactModalContent is not null)
                        {
                            <pre><code>@artifactModalContent</code></pre>
                        }
                        else
                        {
                            <p class="diagnostic-detail">@artifactUnavailableMessage</p>
                        }
                    </div>
                </section>
            </div>
        }
    }
</section>

@code {
    [Parameter] public Guid DocumentId { get; set; }
    private InvoiceDocument? document;
    private IReadOnlyList<ProcessingEvent> events = [];
    private string? extractionJson;
    private bool isArtifactModalVisible;
    private string? artifactModalTitle;
    private string? artifactModalContent;
    private string? artifactUnavailableMessage;
    private string? artifactCopyStatus;
    private string? invoiceNumber;
    private DateOnly? issueDate;
    private DateOnly? dueDate;
    private string? currency;
    private string? buyerName;
    private string? buyerNip;
    private string? sellerName;
    private string? sellerNip;
    private string? paymentMethod;
    private string? bankAccount;
    private decimal? netAmount;
    private decimal? vatAmount;
    private decimal? grossAmount;
    private string? manualSuccess;
    private string? manualError;
    private bool isSaving;

    protected override async Task OnParametersSetAsync()
    {
        document = await InvoiceRepository.GetAsync(new DocumentId(DocumentId), CancellationToken.None);
        events = await ProcessingJobRepository.ListEventsAsync(new DocumentId(DocumentId), CancellationToken.None);
        extractionJson = await ExtractionArtifactHandler.HandleAsync(new DocumentId(DocumentId), CancellationToken.None);
        CloseArtifactModal();
        LoadManualFields();
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string DescribeEvent(ProcessingEvent processingEvent) =>
        processingEvent.Kind == "Started" && processingEvent.Detail.StartsWith("Worker started", StringComparison.Ordinal)
            ? DescribeLegacyStartedStage(processingEvent.Stage, processingEvent.Detail)
            : processingEvent.Kind == "Ollama request sent"
                ? "Exact /api/chat body was recorded before sending to Ollama."
            : processingEvent.Detail;

    private static string DescribeLegacyStartedStage(string stage, string detail) => stage switch
    {
        nameof(ProcessingStatus.Queued) => "Invoice Capture Worker is preparing the job for processing.",
        nameof(ProcessingStatus.Normalizing) => "Invoice Capture Worker is normalizing the source document.",
        nameof(ProcessingStatus.OcrRunning) => "PaddleOCR-VL is performing OCR and layout analysis.",
        nameof(ProcessingStatus.Extracting) => "Ollama gpt-oss:20b is extracting structured invoice fields from OCR output.",
        nameof(ProcessingStatus.Validating) => "C# InvoiceValidator is applying deterministic validation rules.",
        _ => detail
    };

    private static bool IsOllamaExtraction(ProcessingEvent processingEvent) =>
        processingEvent.Stage == nameof(ProcessingStatus.Extracting) && processingEvent.Kind == "Started";

    private void ShowExtractionModal()
    {
        ShowArtifactModal("Ollama response JSON", extractionJson, "The Ollama response artifact is not available for this run.");
    }

    private async Task ShowOllamaRequestModalAsync(Guid artifactId)
    {
        var content = await OllamaRequestArtifactHandler.HandleAsync(new DocumentId(DocumentId), artifactId, CancellationToken.None);
        ShowArtifactModal("Ollama request · exact /api/chat body", content, "The Ollama request artifact is not available for this run.");
    }

    private void ShowArtifactModal(string title, string? content, string unavailableMessage)
    {
        artifactModalTitle = title;
        artifactModalContent = content;
        artifactUnavailableMessage = unavailableMessage;
        artifactCopyStatus = null;
        isArtifactModalVisible = true;
    }

    private void CloseArtifactModal()
    {
        isArtifactModalVisible = false;
        artifactCopyStatus = null;
    }

    private async Task CopyArtifactAsync()
    {
        if (artifactModalContent is null) { return; }
        try
        {
            await JS.InvokeVoidAsync("invoiceCapture.copyText", artifactModalContent);
            artifactCopyStatus = "Content copied to the clipboard.";
        }
        catch (JSException)
        {
            artifactCopyStatus = "The browser could not copy the content. Select the text and copy it manually.";
        }
    }

    private void HandleArtifactModalKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") { CloseArtifactModal(); }
    }

    private static bool TryGetOllamaRequestArtifactId(ProcessingEvent processingEvent, out Guid artifactId)
    {
        const string prefix = "ollama-request:";
        if (processingEvent.Stage == nameof(ProcessingStatus.Extracting) && processingEvent.Kind == "Ollama request sent" && processingEvent.Detail.StartsWith(prefix, StringComparison.Ordinal))
        {
            return Guid.TryParseExact(processingEvent.Detail[prefix.Length..], "N", out artifactId);
        }

        artifactId = default;
        return false;
    }

    private void LoadManualFields()
    {
        if (document is null) { return; }
        invoiceNumber = document.InvoiceNumber;
        issueDate = document.IssueDate;
        dueDate = document.DueDate;
        currency = document.Currency;
        buyerName = document.Buyer?.Name;
        buyerNip = document.Buyer?.Nip;
        sellerName = document.Seller?.Name;
        sellerNip = document.Seller?.Nip;
        paymentMethod = document.PaymentMethod;
        bankAccount = document.BankAccount;
        netAmount = document.Totals?.NetAmount;
        vatAmount = document.Totals?.VatAmount;
        grossAmount = document.Totals?.GrossAmount;
    }

    private async Task SaveManualAsync()
    {
        isSaving = true;
        manualSuccess = null;
        manualError = null;
        try
        {
            document = await ManualInvoiceHandler.HandleAsync(new DocumentId(DocumentId), new ManualInvoiceUpdate(invoiceNumber, issueDate, dueDate, currency, buyerName, buyerNip, sellerName, sellerNip, paymentMethod, bankAccount, netAmount, vatAmount, grossAmount), CancellationToken.None);
            if (document is null)
            {
                manualError = "Document not found.";
                return;
            }

            manualSuccess = "Data saved and validation refreshed.";
        }
        catch (Exception)
        {
            manualError = "Data could not be saved.";
        }
        finally
        {
            isSaving = false;
        }
    }
}
