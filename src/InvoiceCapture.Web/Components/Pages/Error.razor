@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<section class="page-shell" aria-labelledby="error-title">
    <section class="workspace-card detail-card">
        <p class="eyebrow">System</p>
        <h1 id="error-title">Something went wrong</h1>
        <p class="page-description">The request could not be completed. Return to the queue and try again.</p>

        @if (ShowRequestId)
        {
            <p><strong>Request ID:</strong> <code>@RequestId</code></p>
        }

        <p><a class="button button-secondary" href="/documents">Back to queue</a></p>
    </section>
</section>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
