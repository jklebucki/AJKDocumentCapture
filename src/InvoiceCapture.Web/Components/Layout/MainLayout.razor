@inherits LayoutComponentBase
@inject OllamaPromptPreviewService OllamaPromptPreviewService
@inject IJSRuntime JS

<div class="app-shell">
    <header class="app-header">
        <div class="header-content">
            <a class="brand-link" href="/documents" aria-label="Invoice Capture — open queue">
                <img src="logo.svg" alt="Invoice Capture" class="app-logo" />
            </a>
            <button class="header-prompt-button" type="button" @onclick="TogglePrompt" aria-expanded="@isPromptVisible" aria-controls="ollama-prompt-preview">
                <img src="icons/bootstrap-icons-1.13.1/file-earmark-code.svg" alt="" aria-hidden="true" />
                <span>Prompt Ollama</span>
            </button>
            @if (isPromptVisible && prompt is not null)
            {
                <div class="modal-backdrop" @onclick="ClosePrompt">
                    <section id="ollama-prompt-preview" class="prompt-modal" role="dialog" aria-modal="true" aria-labelledby="ollama-prompt-title" @onclick:stopPropagation="true" @onkeydown="HandlePromptKeyDown" tabindex="-1">
                        <header class="prompt-modal-header">
                            <div>
                                <p class="eyebrow">Global template</p>
                                <h2 id="ollama-prompt-title">Ollama prompt · @prompt.Model</h2>
                            </div>
                            <div class="prompt-modal-actions">
                                <button class="icon-button" type="button" @onclick="CopyPromptAsync" aria-label="Copy prompt content" data-tooltip="Copy prompt">
                                    <img src="icons/bootstrap-icons-1.13.1/clipboard.svg" alt="" aria-hidden="true" />
                                </button>
                                <button class="button button-quiet button-small" type="button" @onclick="ClosePrompt">Close</button>
                            </div>
                        </header>
                        <div class="prompt-modal-body">
                            <p>This is the compact template. The exact prompt for a document, including OCR data, is available from its <strong>Ollama request sent</strong> log entry.</p>
                            @if (copyStatus is not null)
                            {
                                <p class="inline-success prompt-copy-status" role="status" aria-live="polite">@copyStatus</p>
                            }
                            <h3>System</h3>
                            <pre><code>@prompt.SystemInstructions</code></pre>
                            <h3>User template</h3>
                            <pre><code>@prompt.UserTemplate</code></pre>
                        </div>
                    </section>
                </div>
            }
            <nav aria-label="Primary navigation">
                <a href="/documents">Queue</a>
                <a href="/diagnostics">Diagnostics</a>
            </nav>
        </div>
    </header>

    <main class="app-content" id="main-content" tabindex="-1">
        @Body
    </main>

    <footer class="app-footer">
        <div class="footer-content">
            <span>Invoice Capture</span>
            <span>Internal document operations</span>
        </div>
    </footer>
</div>

@code {
    private OllamaPromptPreview? prompt;
    private bool isPromptVisible;
    private string? copyStatus;

    protected override void OnInitialized() => prompt = OllamaPromptPreviewService.GetPreview();

    private void TogglePrompt()
    {
        isPromptVisible = !isPromptVisible;
        copyStatus = null;
    }

    private void ClosePrompt()
    {
        isPromptVisible = false;
        copyStatus = null;
    }

    private async Task CopyPromptAsync()
    {
        if (prompt is null) { return; }
        try
        {
            await JS.InvokeVoidAsync("invoiceCapture.copyText", PromptText(prompt));
            copyStatus = "Prompt copied to the clipboard.";
        }
        catch (JSException)
        {
            copyStatus = "The browser could not copy the prompt. Select the text and copy it manually.";
        }
    }

    private void HandlePromptKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") { ClosePrompt(); }
    }

    private static string PromptText(OllamaPromptPreview preview) => $"Ollama prompt · {preview.Model}\n\nSystem\n{preview.SystemInstructions}\n\nUser template\n{preview.UserTemplate}";
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
